{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "rootDir": "src" /* Specify the root folder within your source files. */,
    "baseUrl": ".",
    "outDir": "./dist-electron",
    "strict": false,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "checkJs": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@rpc": ["src/rpc/index.ts"],
      "@rpc/*": ["src/rpc/*"],
      "@Events": ["src/rpc/events/index.ts"],
      "@Utils": ["src/rpc/utils/index.ts"],
      "@config-default": ["src/config.json"],
      "@config": ["src/rpc/config.ts"]
    }
  },
  "include": ["src/main", "src/rpc", "src/renderer"],
  "exclude": ["node_modules", "public", "dist-electorn", "build"]
}
